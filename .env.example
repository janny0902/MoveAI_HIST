# Kakao (필수 — 콘솔 Web 도메인에 http://localhost:20100 등록)
VITE_KAKAO_JS_KEY=
KAKAO_REST_KEY=

# Gemini / Vertex (backend-ai)
# ADC를 쓸 때만 아래 줄을 추가하세요. 빈 값(GOOGLE_ADC_PATH=)으로 두면 마운트가 깨집니다.
# GOOGLE_ADC_PATH=/home/USER/.config/gcloud/application_default_credentials.json
GCP_PROJECT_ID=moveai-504907
GCP_LOCATION=us-central1
VERTEX_ENDPOINT_ID=

# 관리자(/admin) → Cloud Run 직접 호출 (빌드 굽기 없음, 런타임 config.js)
ADMIN_VISION_BASE_URL=https://vision-processor-xi6ooeq3ta-du.a.run.app
ADMIN_MATCHING_BASE_URL=https://matching-processor-xi6ooeq3ta-du.a.run.app
