# 카카오 키 발급 안내
# 1) https://developers.kakao.com → 내 애플리케이션 → 애플리케이션 추가
# 2) 플랫폼 → Web → 사이트 도메인:
#    - 로컬: http://localhost:30100
#    - GCP VM: http://EXTERNAL_IP:30100
# 3) 실제 키는 .env 파일에 넣으세요 (이 파일에는 넣지 마세요)

VITE_KAKAO_JS_KEY=
KAKAO_REST_KEY=

# 관리자 BFF (Spring → Cloud Run, 브라우저는 /api/admin/* 만 호출)
ADMIN_MATCHING_BASE_URL=https://matching-processor-xi6ooeq3ta-du.a.run.app
ADMIN_VISION_BASE_URL=https://vision-processor-xi6ooeq3ta-du.a.run.app

# GCP / Vertex (backend-ai)
GCP_PROJECT_ID=moveai-504907
GCP_LOCATION=us-central1
VERTEX_ENDPOINT_ID=

# ADC JSON 호스트 경로 (컨테이너 /credentials 로 마운트)
# Linux VM 예:
#   GOOGLE_ADC_PATH=/home/USER/.config/gcloud/application_default_credentials.json
# Windows 예:
#   GOOGLE_ADC_PATH=C:/Users/USER/AppData/Roaming/gcloud/application_default_credentials.json
# 없으면 ./secrets/application_default_credentials.json (플레이스홀더) 사용
GOOGLE_ADC_PATH=./secrets/application_default_credentials.json
