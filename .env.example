# 카카오 키 발급 안내
# 1) https://developers.kakao.com → 내 애플리케이션 → 애플리케이션 추가
# 2) 플랫폼 → Web → 사이트 도메인: http://localhost:30100
#    GCP: http://EXTERNAL_IP:30100
# 3) 실제 키는 .env 파일에 넣으세요 (이 파일에는 넣지 마세요)

VITE_KAKAO_JS_KEY=
KAKAO_REST_KEY=

# Linux VM ADC 마운트 (compose 는 ${APPDATA}/gcloud/... 사용 — MoveAI와 동일)
# Windows는 보통 자동. Linux VM 예:
# APPDATA=/home/USER/.config
# (실제 파일: $APPDATA/gcloud/application_default_credentials.json)


# 관리자 BFF (Spring → Cloud Run, 브라우저는 /api/admin/* 만 호출)
ADMIN_MATCHING_BASE_URL=https://matching-processor-xi6ooeq3ta-du.a.run.app
ADMIN_VISION_BASE_URL=https://vision-processor-xi6ooeq3ta-du.a.run.app

# GCP (선택)
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=us-central1
VERTEX_ENDPOINT_ID=

# 적재율 인식: gemini(기본) | hybrid
SPACE_OCCUPANCY_ENGINE=gemini
GEMINI_MODEL=gemini-2.5-flash
