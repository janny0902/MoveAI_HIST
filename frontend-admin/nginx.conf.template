server {
    # Cloud Run이 주입하는 $PORT를 써야 한다. 하드코딩하면 컨테이너가 기동 확인에 실패한다.
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # 해시가 붙은 번들만 장기 캐시한다.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # 배포마다 값이 바뀌므로 캐시하면 안 된다.
    location = /config.js {
        add_header Cache-Control "no-store";
    }
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # SPA 폴백
    location / {
        try_files $uri $uri/ /index.html;
    }
}
